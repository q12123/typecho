---
import type { Post } from '../lib/posts';
import { categoryUrl, formatDate } from '../lib/site';
import BaseLayout from './BaseLayout.astro';
import TagList from '../components/TagList.astro';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const description = post.data.description ?? `${post.data.title} 的文章正文。`;
---

<BaseLayout title={post.data.title} description={description} image={post.data.cover} type="article">
  <article class="article">
    <header class="article-header">
      <div class="post-meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        {post.data.updated && <span>更新于 {formatDate(post.data.updated)}</span>}
        {post.data.category && <a href={categoryUrl(post.data.category)}>{post.data.category}</a>}
      </div>
      <h1>{post.data.title}</h1>
      {description && <p>{description}</p>}
      <TagList tags={post.data.tags} />
    </header>
    {post.data.cover && <img class="cover" src={post.data.cover} alt="" />}
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
