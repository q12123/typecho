---
import PostCard from '../components/PostCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCategories, getPublishedPosts, getTags } from '../lib/posts';
import { SITE_DESCRIPTION, categoryUrl, tagUrl } from '../lib/site';

const posts = await getPublishedPosts();
const categories = getCategories(posts);
const tags = getTags(posts);
---

<BaseLayout title="文章" description={SITE_DESCRIPTION}>
  <section class="home-hero">
    <p class="eyebrow">Astro + Markdown + Cloudflare Pages</p>
    <h1>轻量、安静、面向写作的静态博客</h1>
    <p>{SITE_DESCRIPTION}</p>
  </section>

  <div class="content-grid">
    <section class="post-list" aria-label="文章列表">
      {posts.map((post) => <PostCard post={post} />)}
    </section>

    <aside class="sidebar" aria-label="归档导航">
      <section>
        <h2>分类</h2>
        <ul class="link-list">
          {categories.map((category) => (
            <li><a href={categoryUrl(category.name)}>{category.name}<span>{category.count}</span></a></li>
          ))}
        </ul>
      </section>
      <section>
        <h2>标签</h2>
        <ul class="tag-cloud">
          {tags.map((tag) => <li><a href={tagUrl(tag.name)}>{tag.name}</a></li>)}
        </ul>
      </section>
    </aside>
  </div>
</BaseLayout>
