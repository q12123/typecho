---
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCategories, getPublishedPosts, postsByCategory } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return getCategories(posts).map((category) => ({
    params: { slug: category.slug },
    props: { category, posts: postsByCategory(posts, category.slug) },
  }));
}

const { category, posts } = Astro.props;
---

<BaseLayout title={`分类：${category.name}`} description={`分类 ${category.name} 下的全部文章。`}>
  <section class="archive-header">
    <p class="eyebrow">Category</p>
    <h1>{category.name}</h1>
    <p>共 {posts.length} 篇文章</p>
  </section>
  <section class="post-list">
    {posts.map((post) => <PostCard post={post} />)}
  </section>
</BaseLayout>
