---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="你访问的页面不存在或已经移动。">
  <section class="not-found">
    <p class="eyebrow">404</p>
    <h1>页面不存在</h1>
    <p>这条路径没有对应的静态页面。可以回到首页继续阅读。</p>
    <a class="button-link" href="/">回到首页</a>
  </section>
</BaseLayout>
